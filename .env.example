# Copy to `.env.local` in the project root and set values there.
# `.env.local` is gitignored — never commit real keys.
#
# Gemini: create the key in Google AI Studio (same free-tier REST API as their docs):
# https://aistudio.google.com/apikey
# This app calls generativelanguage.googleapis.com with ?key= — not Vertex AI
# (aiplatform.googleapis.com / OAuth), which is a different product and billing path.
VITE_GEMINI_API_KEY=
# Optional; default is gemini-2.5-flash (free tier is unreliable for 2.0-flash).
# Try gemini-2.5-flash-lite if you still hit quota. Confirm names with GET .../v1beta/models?key=...
# VITE_GEMINI_MODEL=

# D-ID: API key from https://studio.d-id.com/ (Talks / avatars REST API).
# Used as HTTP Basic username with an empty password (see D-ID docs).
VITE_DID_API_KEY=

# EmailJS: https://www.emailjs.com/ — create a service + template, then copy IDs.
# Template variables must include: from_name, message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
